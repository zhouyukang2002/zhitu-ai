# ==========================================
# 智途 AI (Zhitu-AI) 环境变量配置模板
# 复制本文件为 .env 或配置到系统中
# ==========================================

# 大语言模型配置 (支持 DeepSeek, 通义千问, OpenAI 等兼容端点)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_CHAT_MODEL=deepseek-chat

# 向量检索与重排模型配置 (阿里 DashScope / 通义千问)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v3
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank
RERANK_API_KEY=your_dashscope_api_key_here
RERANK_MODEL=gte-rerank-v2

# 数据库与中间件配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch 向量检索服务配置
ES_HOST=127.0.0.1
ES_PORT=9200
# SPRING_ELASTICSEARCH_URIS=http://127.0.0.1:9200

# MCP 业务模拟器服务配置
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8081

# 前端开发服务器反向代理目标
VITE_BACKEND_URL=http://127.0.0.1:8080

# 评测脚本目标引擎端点 (可选，默认 http://localhost:8080)
# BASE_URL=http://localhost:8080

# 知识库语料目录 (相对路径或绝对路径，系统支持自适应探活)
TUTOR_CORPUS_DIR=../corpus
