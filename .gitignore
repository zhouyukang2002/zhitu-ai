# ==========================================
# Zhitu-AI Monorepo Git Ignore Rules
# ==========================================

# IDE & Editor
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment & Local Secrets
*.env
.env.local
.env.*.local
!*.example
*local.yml
*local.yaml
application-local.yml

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.tmp/
temp/

# Java / Maven build output
**/target/
**/.flattened-pom.xml

# Node / Frontend build output
**/node_modules/
**/dist/
**/.turbo/

# Python / Scripts output
**/__pycache__/
*.pyc

# Local binary runtime
elasticsearch-*/
**/data/indices/
